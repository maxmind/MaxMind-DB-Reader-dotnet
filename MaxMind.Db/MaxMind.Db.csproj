<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>.NET reader for the MaxMind DB file format</Description>
    <VersionPrefix>5.1.0</VersionPrefix>
    <TargetFrameworks>net10.0;net9.0;net8.0;netstandard2.1;netstandard2.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>MaxMind.Db</AssemblyName>
    <AssemblyOriginatorKeyFile>../MaxMind.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition=" '$(OS)' != 'Windows_NT' ">true</PublicSign>
    <PackageId>MaxMind.Db</PackageId>
    <PackageTags>maxmind;ip;geoip;geoip2;geolocation;maxmind;ipv4;ipv6;mmdb;maxminddb</PackageTags>
    <PackageIcon>MaxMind-logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/maxmind/MaxMind-DB-Reader-dotnet</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>5.1.0</PackageValidationBaselineVersion>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/maxmind/MaxMind-DB-Reader-dotnet</RepositoryUrl>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <AssemblyVersion>5.0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <LangVersion>14.0</LangVersion>
    <MaxMindDbAnalyzerPackSource>..\MaxMind.Db.SourceGenerator\bin\$(Configuration)\netstandard2.0\MaxMind.Db.SourceGenerator.dll</MaxMindDbAnalyzerPackSource>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- In CI, don't fail the build on NuGet audit advisories (NU1901-NU1905).
         Advisories still appear in build output, and Dependabot handles the
         actual fix. Local builds keep the strict behavior. -->
    <WarningsNotAsErrors Condition="'$(CI)' == 'true'">$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- The packed path below is hard-coded, which a change to the generator's target
       framework or output layout would silently invalidate: the stale assembly left
       at the old location would be packed without complaint. Ask the generator
       project where its output actually is and fail the pack if the two disagree. -->
  <Target Name="VerifyMaxMindDbAnalyzerIsCurrent" BeforeTargets="Pack">
    <MSBuild Projects="..\MaxMind.Db.SourceGenerator\MaxMind.Db.SourceGenerator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="MaxMindDbAnalyzerAssembly" />
    </MSBuild>
    <PropertyGroup>
      <MaxMindDbPackedAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(MaxMindDbAnalyzerPackSource)'))</MaxMindDbPackedAnalyzerPath>
      <MaxMindDbBuiltAnalyzerPath>@(MaxMindDbAnalyzerAssembly->'%(FullPath)')</MaxMindDbBuiltAnalyzerPath>
    </PropertyGroup>
    <Error Condition="'$(MaxMindDbBuiltAnalyzerPath)' == ''"
           Text="Could not resolve the MaxMind.Db source generator output. Packing would ship without an analyzer and consumers would silently fall back to reflection." />
    <Error Condition="'$(MaxMindDbPackedAnalyzerPath)' != '$(MaxMindDbBuiltAnalyzerPath)'"
           Text="The analyzer being packed ($(MaxMindDbPackedAnalyzerPath)) is not the generator's current output ($(MaxMindDbBuiltAnalyzerPath)). Update MaxMindDbAnalyzerPackSource in this file." />
  </Target>

  <ItemGroup>
    <CodeAnalysisDictionary Include="CustomDictionary.xml" />
    <ProjectReference Include="..\MaxMind.Db.SourceGenerator\MaxMind.Db.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MaxMindDbAnalyzerPackSource)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Remove="buildTransitive\MaxMind.Db.targets" />
    <None Include="buildTransitive\MaxMind.Db.targets"
          Pack="true"
          PackagePath="buildTransitive" />
    <None Include="..\MaxMind-logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
